# /opt/data/.env  (chmod 600)
DATA_IP=192.168.88.104
MSSQL_SA_PASSWORD=Change-Me-Strong-2026!
MSSQL_PID=Express                   # Express ฟรี (DB ละ ≤10 GB, cache ≈1.4 GB) / Standard ตาม license — ห้าม Developer บน production
MSSQL_MEMORY_LIMIT_MB=2048          # RAM 4 GB = 2048, RAM 8 GB = 5120
MSSQL_BACKUP_DBS="GoAlongDatabase"  # ชื่อ DB ที่ต้อง backup (คั่นด้วยช่องว่าง)
BACKUP_TARGET=                      # ว่างไว้ = เก็บแค่ในเครื่อง (/srv/mssql/backup) · ใส่ปลายทางนอกเครื่องเท่านั้น เช่น backup@nas:/backup/mssql/ (ห้ามมีช่องว่างหลัง =)
REDIS_PASSWORD=change-me-redis
RABBITMQ_USER=erp
RABBITMQ_PASS=change-me-rabbit
ERP_APP_LOGIN=erp_app            # login ที่แอปใช้แทน sa — สร้างด้วย data/mssql-app-user.sh
ERP_APP_PASSWORD=                   # ว่างไว้ได้ script จะสร้างให้

# หน่วยความจำของ Redis / RabbitMQ — RAM 4 GB ใช้ค่าด้านล่าง, RAM 8 GB ขึ้นไปลบ 3 บรรทัดนี้ทิ้ง (ได้ค่า default 768mb / 1g / 1g)
REDIS_MAXMEMORY=384mb
REDIS_MEM_LIMIT=512m
RABBITMQ_MEM_LIMIT=512m
