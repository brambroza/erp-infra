# erpapi (go-crmapi24 / goalongapi .NET) — copy เป็น erpapi.env (chmod 600) แล้วใส่ค่าจริง
# image เดิมไม่มี env ของตัวเอง ค่าทั้งหมดมาจาก appsettings.json ที่ build ติดอยู่ใน image
# ASP.NET Core ให้ env ทับ appsettings ได้ โดยเขียน key ซ้อนด้วย __ (สองขีด)
# ใส่เฉพาะค่าที่ต้องเปลี่ยน — key ที่ไม่ใส่จะใช้ค่าใน image ตามเดิม
#
# ห้ามเปลี่ยนในรอบย้ายเครื่อง (ถ้าเปลี่ยน ผู้ใช้หลุด login หรือข้อมูลที่เข้ารหัสไว้อ่านไม่ได้):
#   JwtSettings__Key, EmailCrypto__KeyBase64, NisRealtime__InternalSecret

# --- SQL Server บน erp-db-01 (login erp_app จาก data/mssql-app-user.sh) ---
ConnectionStrings__ConnectionSQLServer=Server=192.168.88.12,1433;Database=GoAlongDatabase;User Id=erp_app;Password=CHANGE_ME;TrustServerCertificate=True;

# --- RabbitMQ บน erp-db-01 (RABBITMQ_USER / RABBITMQ_PASS ใน /opt/data/.env) ---
RabbitMQ__Host=192.168.88.12
RabbitMQ__Port=5672
RabbitMQ__UserName=erp
RabbitMQ__Password=CHANGE_ME
