# copy เป็น erpapi.env (chmod 600) แล้วใส่ค่าจริง
# วิธีที่ง่ายที่สุด: scripts/export-env.sh go-crmapi24 > erpapi.env แล้วแก้ host ให้ชี้ vm-data-4
# ชื่อ key ด้านล่างเป็นตัวอย่าง ให้ใช้ชื่อเดียวกับที่แอปใช้จริง
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=Server=192.168.88.104,1433;Database=CRMDB;User Id=erp_app;Password=CHANGE_ME;TrustServerCertificate=True
Redis__ConnectionString=192.168.88.104:6379,password=CHANGE_ME
RabbitMQ__HostName=192.168.88.104
RabbitMQ__UserName=erp
RabbitMQ__Password=CHANGE_ME
