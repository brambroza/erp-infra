# tag ที่ deploy อยู่ของแต่ละ service — Jenkins แก้ไฟล์นี้บน vm-service-1 ทุกครั้งที่ deploy
# ใส่ tag จริงก่อน deploy ครั้งแรก (ห้ามใช้ latest)
STACK_MODE=test                 # test = บล็อก LINE/push ออก · เปลี่ยนเป็น live ตอน cutover เท่านั้น
ERPAPP_TAG=CHANGE_ME
ERPAPI_TAG=CHANGE_ME
CHATAPI_TAG=CHANGE_ME
TICKER_TAG=legacy-2026-10
TICKER_REPLICAS=0               # ตั้งเป็น 1 ตอน cutover หลังปิด ticker บนเครื่องเดิม
ERPAPI_REPLICAS=1               # 2 ได้เมื่อ coreapi มี SignalR Redis backplane + background service รันตัวเดียว
CHATAPI_REPLICAS=1              # 2 ได้เมื่อ image มี runCronExclusive + dedupe ใน Redis และทดสอบ lock แล้ว
