# tag ที่ deploy อยู่ของแต่ละ service — Jenkins แก้ไฟล์นี้บน erp-app-01 ทุกครั้งที่ deploy
# รูปแบบ tag: latest@sha256:<digest> (Jenkins ปักให้เอง) หรือ sha-<7 ตัว> · ห้ามใช้ latest เปล่า ๆ
STACK_MODE=test                 # test = บล็อก LINE/push ออก · เปลี่ยนเป็น live ตอน cutover เท่านั้น
ERPAPP_TAG=CHANGE_ME
ERPAPI_TAG=CHANGE_ME
CHATAPI_TAG=CHANGE_ME
TICKER_TAG=legacy-2026-10
TICKER_REPLICAS=0               # ตั้งเป็น 1 ตอน cutover หลังปิด ticker บนเครื่องเดิม
ERPAPI_REPLICAS=1               # เครื่องจริงตั้ง 2 (image มี Redis backplane + SqlAppLock แล้ว)
CHATAPI_REPLICAS=1              # เครื่องจริงตั้ง 2 (image มี runCronExclusive + dedupe ใน Redis และทดสอบ lock แล้ว)
