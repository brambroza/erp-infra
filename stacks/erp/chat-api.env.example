# chat-api (go-chat-api, Node.js) — copy เป็น chat-api.env (chmod 600)
# วิธีที่ง่ายที่สุด: บนเครื่องเดิมรัน  scripts/export-env.sh go-chat-api > chat-api.env
# แล้วแก้เฉพาะ 7 บรรทัดด้านล่างให้ชี้ erp-db-01 — ค่าอื่น (JWT_*, CLIENT_*, FB_*, REFRESH_TOKEN ...) ใช้ค่าเดิม

PORT=3000                                   # ต้องตรงกับ target ใน stack.yml

# --- SQL Server บน erp-db-01 ---
DB_HOST=192.168.88.12
DB_USER=erp_app
DB_PASSWORD=CHANGE_ME                       # ERP_APP_PASSWORD ใน /opt/data/.env
DB_NAME=GoAlongDatabase

# --- RabbitMQ (รหัสเป็น hex จาก openssl จึงใส่ใน URL ได้ตรง ๆ) ---
RABBITMQ_URL=amqp://erp:CHANGE_ME@192.168.88.12:5672

# --- Redis ---
# โค้ดต่อ redis://${REDIS_HOST}:${REDIS_PORT} และยังไม่มีตัวแปรรหัสผ่าน
# จึงใส่รหัสไว้หน้า host:  REDIS_HOST=:<REDIS_PASSWORD>@192.168.88.12  → redis://:<รหัส>@192.168.88.12:6379
REDIS_HOST=:CHANGE_ME@192.168.88.12
REDIS_PORT=6379
