# ============================================================
# erp-infra inventory — แหล่งเดียวของ hostname / IP
# script ทุกตัวอ่านไฟล์นี้  (ไม่มีรหัสผ่าน รหัสผ่านอยู่ใน secrets.env)
# IP ทั้งหมดเป็นตัวอย่างใน 192.168.88.0/24 → แก้ให้ตรงของจริงก่อนใช้
# ============================================================

# ---- Gateway (Nginx + keepalived) ----
VIP=192.168.88.100              # IP กลางที่ Router port forward 80/443 เข้ามา
GW_MASTER_HOST=gw-1
GW_MASTER_IP=192.168.88.101
GW_BACKUP_HOST=gw-2
GW_BACKUP_IP=192.168.88.102

# ---- Swarm cluster ----
SVC1_HOST=vm-service-1          # Swarm manager
SVC1_IP=192.168.88.111
SVC2_HOST=vm-service-2          # Swarm worker
SVC2_IP=192.168.88.112

# ---- Data ----
DATA_HOST=vm-data-4             # SQL Server, Redis, RabbitMQ, NFS (Data API files)
DATA_IP=192.168.88.104

# ---- CI/CD ----
JENKINS_HOST=vm-deploy
JENKINS_IP=192.168.88.120

# ---- บริการเดิมที่ยังเป็นเครื่องเดียว ----
LEGACY_IP=192.168.88.10         # เครื่องเดิม: app.nisolution :3030, n8n :5678, :10053
ZBX_HOST=192.168.88.21          # zabbix / api-zabbix / monitor-zb
ZABBIX_SERVER=192.168.88.21     # ที่ zabbix-agent ส่งข้อมูลไป

# ---- Network ----
ADMIN_NET=192.168.88.0/24       # เครือข่ายที่ SSH เข้าได้
NET_PREFIX=24
IFACE=ens18                     # ชื่อ interface (ดูด้วย: ip -br link)

# ---- Domain ----
DOMAIN_ERP=erp.nisolution.co.th
DOMAIN_API=api.nisolution.co.th
